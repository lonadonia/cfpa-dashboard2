# Optionale Einstellungen für den lokalen Server (server.js).
# Nutzung mit Node.js >= 20.6:  node --env-file=.env server.js
# oder direkt:                  PORT=8080 node server.js   (Windows: set PORT=8080 && node server.js)

# Port des Servers
PORT=8080

# 0.0.0.0 = im WLAN erreichbar (Handy-Fernbedienung) · 127.0.0.1 = nur dieser Rechner
HOST=0.0.0.0

# Optionaler Zugriffsschlüssel für Änderungen (Regie/Fernbedienung dann mit ?key=… öffnen).
# Leer lassen = kein Schlüssel. Beispielwert NICHT übernehmen, eigenen wählen.
OVERLAY_KEY=

# Speicherort für state.json (Texte, Logo, Szenen)
DATA_DIR=./data
